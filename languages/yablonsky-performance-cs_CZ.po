msgid "Account verified, but no usable current workspace was returned."
msgstr ""
"Účet byl ověřen, ale nebyl nalezen žádný použitelný aktuální pracovní "
"prostor."

msgid "Action Scheduler is outside the active runtime stack for this site."
msgstr "Action Scheduler není součástí aktivního běhového prostředí tohoto webu."

msgid ""
"Action Scheduler workload evidence is available after its runtime store "
"initializes."
msgstr ""
"Údaje o zatížení Action Scheduleru budou dostupné po inicializaci jeho "
"běhového úložiště."

msgid ""
"Action Scheduler workload is visible: %1$d pending, %2$d past-due and %3$d "
"failed actions."
msgstr ""
"Zatížení Action Scheduleru: čekajících akcí %1$d, opožděných %2$d a "
"neúspěšných %3$d."

#: includes/class-yperf-admin.php
msgid "Activate & Prove Object Cache"
msgstr "Aktivovat a ověřit objektovou mezipaměť"

msgid ""
"Activate W3 Total Cache, prepare the migration, and then deactivate it "
"yourself from Plugins before YPerf claims any replacement layer."
msgstr ""
"Aktivujte W3 Total Cache, připravte migraci a poté jej sami deaktivujte na "
"obrazovce Pluginy, než YPerf převezme některou náhradní vrstvu."

#: includes/class-yperf-admin.php
msgid "Activate YPerf Object Cache & Prove"
msgstr "Aktivovat objektovou mezipaměť YPerf a ověřit funkčnost"

#: includes/class-yperf-migration-journey.php
msgid "Activate a safe YPerf baseline"
msgstr "Aktivovat bezpečnou výchozí konfiguraci YPerf"

#: includes/class-yperf-admin.php
msgid "Activate the recommended local profile"
msgstr "Aktivovat doporučený místní profil"

#: includes/class-yperf-admin.php
msgid "Activate, prove and roll back the YPerf Redis executor"
msgstr "Aktivovat, ověřit a případně vrátit zpět komponentu Redis systému YPerf"

msgid "Activating the YPerf Page Cache replacement."
msgstr "Aktivuje se náhradní mezipaměť stránek YPerf."

#: includes/class-yperf-page-cache-campaign.php
msgid "Activating the YPerf-owned Page Cache boundary."
msgstr "Aktivuje se vrstva mezipaměti stránek spravovaná YPerf."

#: includes/class-yperf-admin.php
msgid "Activation remains blocked."
msgstr "Aktivace je nadále zablokována."

#: includes/class-yperf-admin.php
msgid "Active"
msgstr "Aktivní"

#: includes/class-yperf-admin.php
msgid "Active plugins"
msgstr "Aktivní pluginy"

#: includes/class-yperf-admin.php
