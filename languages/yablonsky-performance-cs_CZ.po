#: includes/class-yperf-admin.php
msgid "AI Advisor created a recommendation. Review the validated plan before Apply."
msgstr "Poradce AI vytvořil doporučení. Před použitím zkontrolujte ověřený plán."

#: includes/class-yperf-admin.php
msgid ""
"AI-assisted Apply is blocked until a clean current-version Runtime "
"Acceptance exists."
msgstr ""
"Použití nastavení s podporou AI je zablokováno, dokud neproběhne úspěšná "
"kontrola za běhu pro aktuální verzi."

#: includes/class-yperf-admin.php
msgid "AI-assisted Apply was blocked safely."
msgstr "Použití nastavení s podporou AI bylo bezpečně zablokováno."

#: includes/class-yperf-admin.php
msgid "AI-assisted configuration, human-approved"
msgstr "Konfigurace s podporou AI, schválená člověkem"

#: includes/class-yperf-admin.php
