msgid "Activating the YPerf Page Cache replacement."
msgstr "Notiek YPerf lapu kešatmiņas aizvietotāja aktivizēšana."

#: includes/class-yperf-page-cache-campaign.php
msgid "Activating the YPerf-owned Page Cache boundary."
msgstr "Notiek YPerf pārvaldītās lapu kešatmiņas robežas aktivizēšana."

#: includes/class-yperf-admin.php
