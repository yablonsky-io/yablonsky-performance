#: includes/class-yperf-admin.php
msgid "AI Advisor answered the performance question."
msgstr "Poradca AI odpovedal na otázku o výkone."

#: includes/class-yperf-admin.php
msgid "AI Advisor created a recommendation. Review the validated plan before Apply."
msgstr "Poradca AI vytvoril odporúčanie. Pred použitím skontrolujte overený plán."

#: includes/class-yperf-admin.php
msgid ""
"AI-assisted Apply is blocked until a clean current-version Runtime "
"Acceptance exists."
msgstr ""
"Použitie konfigurácie s podporou AI je zablokované, kým aktuálna verzia "
"úspešne neprejde prevádzkovým overením."

#: includes/class-yperf-admin.php
msgid "AI-assisted Apply was blocked safely."
msgstr "Použitie konfigurácie s podporou AI bolo bezpečne zablokované."

#: includes/class-yperf-admin.php
msgid "AI-assisted configuration, human-approved"
msgstr "Konfigurácia s podporou AI schválená človekom"

#: includes/class-yperf-admin.php
msgid "AI-assisted performance plan was accepted after Runtime Acceptance."
msgstr ""
"Plán optimalizácie s podporou AI bol prijatý po úspešnom prevádzkovom "
"overení."

#: includes/class-yperf-recommendations.php
msgid "AI-ready evidence"
msgstr "Dôkazy pripravené pre AI"

#: includes/class-yperf-admin.php
msgid "AI-ready · local"
msgstr "Pripravené pre AI · lokálne"

#: includes/class-yperf-admin.php
msgid "ATTENTION"
msgstr "POZOR"

#: includes/class-yperf-admin.php
msgid "ATTN"
msgstr "POZOR"

#: includes/class-yperf-admin.php includes/class-yperf-environment-check.php
msgid "Absent"
msgstr "Chýba"

#: includes/class-yperf-admin.php includes/class-yperf-product-progress.php
msgid "Acceptance"
