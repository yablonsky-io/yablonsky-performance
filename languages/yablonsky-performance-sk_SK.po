#. Extracted from PHP source; i18n unification.
#: includes/class-yperf-admin.php
msgid "Access denied."
msgstr "Prístup odepren."

#: includes/class-yperf-admin.php
msgid "Account verified, but no usable current workspace was returned."
msgstr ""
"Účet bol overený, ale nebol nájdený žiadny použiteľný aktuálny pracovný "
"priestor."

msgid "Action Scheduler is outside the active runtime stack for this site."
msgstr ""
"Action Scheduler nie je súčasťou aktívneho prevádzkového prostredia tohto "
"webu."

msgid ""
"Action Scheduler workload evidence is available after its runtime store "
"initializes."
msgstr ""
"Údaje o záťaži Action Scheduleru budú dostupné po inicializácii jeho "
"prevádzkového úložiska."

msgid ""
"Action Scheduler workload is visible: %1$d pending, %2$d past-due and %3$d "
"failed actions."
msgstr ""
"Záťaž Action Scheduleru: %1$d čakajúcich, %2$d oneskorených a %3$d "
"neúspešných akcií."

#: includes/class-yperf-admin.php
msgid "Activate & Prove Object Cache"
msgstr "Aktivovať a overiť cache objektov"

msgid ""
"Activate W3 Total Cache, prepare the migration, and then deactivate it "
"yourself from Plugins before YPerf claims any replacement layer."
msgstr ""
"Aktivujte W3 Total Cache, pripravte migráciu a potom ho sami deaktivujte na "
"obrazovke Doplnky skôr, než YPerf prevezme ktorúkoľvek náhradnú vrstvu."

#: includes/class-yperf-admin.php
msgid "Activate YPerf Object Cache & Prove"
msgstr "Aktivovať a overiť cache objektov YPerf"

#: includes/class-yperf-migration-journey.php
msgid "Activate a safe YPerf baseline"
msgstr "Aktivovať bezpečnú východiskovú konfiguráciu YPerf"

#: includes/class-yperf-admin.php
msgid "Activate the recommended local profile"
msgstr "Aktivovať odporúčaný lokálny profil"

#: includes/class-yperf-admin.php
msgid "Activate, prove and roll back the YPerf Redis executor"
msgstr ""
"Aktivovať, overiť a v prípade potreby vrátiť späť vykonávací mechanizmus "
"Redis YPerf"

msgid "Activating the YPerf Page Cache replacement."
msgstr "Aktivuje sa náhradná cache stránok YPerf."

#: includes/class-yperf-page-cache-campaign.php
msgid "Activating the YPerf-owned Page Cache boundary."
msgstr "Aktivuje sa vrstva cache stránok spravovaná YPerf."

#: includes/class-yperf-admin.php
