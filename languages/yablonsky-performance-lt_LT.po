msgstr ""
"DI padedamas taikymas blokuojamas, kol nėra sėkmingos dabartinės versijos "
"veikimo aplinkos priėmimo patikros."

#: includes/class-yperf-admin.php
msgid "AI-assisted Apply was blocked safely."
msgstr "DI padedamas taikymas saugiai užblokuotas."

#: includes/class-yperf-admin.php
msgid "AI-assisted configuration, human-approved"
msgstr "DI padedama konfigūracija, patvirtinama žmogaus"

#: includes/class-yperf-admin.php
