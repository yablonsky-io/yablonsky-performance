"Adopt a fresh, proven native page-cache executor before preparing host "
"operations."
msgstr ""
"Adopsi eksekutor cache halaman native yang baru dan terbukti sebelum "
"menyiapkan operasi host."

#: includes/class-yperf-admin.php
msgid "Adopt aligned profile & enable purge sync"
msgstr "Terapkan profil yang selaras dan aktifkan sinkronisasi pembersihan"

#: includes/class-yperf-admin.php
