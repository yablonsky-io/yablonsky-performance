msgstr "Numai Yablonsky AI"

#: includes/class-yperf-admin.php
msgid "Yablonsky AI or local Autopilot"
msgstr "Yablonsky AI sau pilot automat local"

#: includes/class-yperf-yablonsky-ai-client.php
msgid "Yablonsky AI request was blocked because the instruction was empty."
msgstr "Solicitarea Yablonsky AI a fost blocată deoarece instrucțiunea era goală."

#: includes/class-yperf-ai-advisor.php
msgid "Yablonsky AI returned a response that could not be validated."
msgstr "Yablonsky AI a returnat un răspuns care nu a putut fi validat."

#: includes/class-yperf-yablonsky-ai-client.php
msgid ""
"Yablonsky AI returned an account response that did not match the reviewed "
"User API shape."
msgstr ""
"Yablonsky AI a returnat un răspuns de cont care nu corespundea structurii API"
" pentru utilizator revizuite."

#: includes/class-yperf-yablonsky-ai-client.php
msgid "Yablonsky AI returned an unsuccessful model-specific response."
msgstr "Yablonsky AI a returnat un răspuns nereușit pentru modelul specificat."

#: includes/class-yperf-yablonsky-ai-client.php
msgid "Yablonsky AI returned an unsuccessful response."
msgstr "Yablonsky AI a returnat un răspuns nereușit."

#: includes/class-yperf-yablonsky-ai-client.php
msgid "Yablonsky AI returned no usable Writer text."
msgstr "Yablonsky AI nu a returnat text Writer utilizabil."

