#: includes/class-yperf-admin.php
msgid "Account verified, but no usable current workspace was returned."
msgstr ""
"Il-kont ġie vverifikat, iżda ma ngħatax spazju tax-xogħol attwali li jista' "
"jintuża."

msgid "Action Scheduler is outside the active runtime stack for this site."
msgstr ""
"Action Scheduler huwa barra mill-munzell ta' eżekuzzjoni attiv għal dan is-"
"sit."

msgid ""
"Action Scheduler workload evidence is available after its runtime store "
"initializes."
msgstr ""
"L-evidenza tat-tagħbija ta' Action Scheduler tkun disponibbli wara li "
"jinbeda l-ħażna tad-dejta tiegħu."

msgid ""
"Action Scheduler workload is visible: %1$d pending, %2$d past-due and %3$d "
"failed actions."
msgstr ""
"It-tagħbija ta' Action Scheduler hija viżibbli: %1$d azzjonijiet pendenti, "
"%2$d skaduti u %3$d fallew."

#: includes/class-yperf-admin.php
msgid "Activate & Prove Object Cache"
msgstr "Attiva u vverifika l-cache tal-oġġetti"

msgid ""
"Activate W3 Total Cache, prepare the migration, and then deactivate it "
"yourself from Plugins before YPerf claims any replacement layer."
msgstr ""
"Attiva W3 Total Cache, ħejji l-migrazzjoni, u mbagħad iddiżattivah int stess"
" mill-Plugins qabel YPerf jieħu r-responsabbiltà għal xi saff sostitut."

#: includes/class-yperf-admin.php
msgid "Activate YPerf Object Cache & Prove"
msgstr "Attiva l-cache tal-oġġetti ta' YPerf u vverifika"

#: includes/class-yperf-migration-journey.php
msgid "Activate a safe YPerf baseline"
msgstr "Attiva linja bażi sigura ta' YPerf"

#: includes/class-yperf-admin.php
msgid "Activate the recommended local profile"
msgstr "Attiva l-profil lokali rakkomandat"

#: includes/class-yperf-admin.php
msgid "Activate, prove and roll back the YPerf Redis executor"
msgstr "Attiva, ivverifika u erġa' lura mill-eżekutur Redis ta' YPerf"

msgid "Activating the YPerf Page Cache replacement."
msgstr "Qed tiġi attivata s-sostituzzjoni tal-cache tal-paġni ta' YPerf."

#: includes/class-yperf-page-cache-campaign.php
msgid "Activating the YPerf-owned Page Cache boundary."
msgstr "Qed jiġi attivat il-limitu tal-cache tal-paġni taħt is-sjieda ta' YPerf."

#: includes/class-yperf-admin.php
msgid "Activation remains blocked."
msgstr "L-attivazzjoni tibqa' mblukkata."

#: includes/class-yperf-admin.php
