msgstr ""
"YPerf ma għamel l-ebda bidla fl-attivazzjoni tal-plugins. Irrevedi l-istat "
"tas-sjieda tal-cache tal-paġni qabel terġa' tipprova."

#: includes/class-yperf-admin.php
msgid "YPerf may change"
msgstr "YPerf jista' jbiddel"

#: includes/class-yperf-admin.php
