msgstr ""
"YPerf mhux se jibgħat kredenzjal sakemm l-endpoint HTTPS, il-mod tal-"
"awtentikazzjoni, il-header tal-ispazju tax-xogħol u t-trasport Writer "
"jgħaddu kollha mill-kontroll tal-kuntratt lokali."

#: includes/class-yperf-environment-check.php
msgid "YPerf will preserve cart, checkout, account and session bypass rules."
msgstr ""
"YPerf se jippreserva r-regoli BYPASS għall-karrettun, checkout, kont u "
"sessjoni."

#: includes/class-yperf-admin.php
msgid ""
"YPerf will save the exact local diff and the post-apply Runtime Acceptance "
