msgid "Unknown"
msgstr "Неизвестно"

#: includes/class-yperf-page-cache-campaign.php
msgid "Unknown Page Cache campaign step."
msgstr "Неизвестна стъпка от кампанията за кеша за страници."

#: includes/class-yperf-admin.php
msgid "Unknown Runtime Acceptance step."
msgstr "Неизвестна стъпка от приемането в работна среда."

#: includes/class-yperf-admin.php
msgid "Unknown benchmark step."
msgstr "Неизвестна стъпка от бенчмарка."

#: includes/class-yperf-admin.php
