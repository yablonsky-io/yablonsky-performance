msgstr "Връщане назад на промените от миграцията на YPerf"

#: includes/class-yperf-admin.php
msgid "Rollback YPerf Cloudflare changes"
msgstr "Връщане назад на промените на YPerf в Cloudflare"

#: includes/class-yperf-admin.php
msgid "Rollback contract."
msgstr "Договор за връщане назад."

#: includes/class-yperf-w3tc-migration-executor.php
msgid "Rollback stopped because another advanced-cache.php now exists. YPerf will not overwrite it."
msgstr "Връщането назад спря, защото вече съществува друг advanced-cache.php. YPerf няма да го презаписва."

#: includes/class-yperf-admin.php
