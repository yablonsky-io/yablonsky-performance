msgstr "Неизвестен механизъм"

#: includes/class-yperf-admin.php
msgid "Unknown frontend control operation."
msgstr "Неизвестна операция за управление на публичния интерфейс."

msgid "Unknown iframes, custom players and dynamic embeds remain unchanged."
msgstr ""
"Неизвестните iframe вграждания, персонализирани плейъри и динамични вграждания остават "
"непроменени."

#: includes/class-yperf-admin.php
msgid "Unlimited / unknown"
msgstr "Неограничено / неизвестно"

#: includes/class-yperf-host-snapshot.php
msgid "Unsupported Host Intelligence schema."
msgstr "Неподдържана схема на Host Intelligence."

#: includes/class-yperf-admin.php
msgid "Unsupported YPerf control operation."
