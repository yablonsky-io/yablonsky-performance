#: includes/class-yperf-admin.php
msgid "Account verified, but no usable current workspace was returned."
msgstr ""
"Compte vérifié, mais aucun espace de travail actuel utilisable n’a été "
"renvoyé."

msgid "Action Scheduler is outside the active runtime stack for this site."
msgstr "Action Scheduler ne fait pas partie de la pile d’exécution active de ce site."

msgid ""
"Action Scheduler workload evidence is available after its runtime store "
"initializes."
msgstr ""
"Les données de charge d’Action Scheduler seront disponibles après "
"l’initialisation de son stockage d’exécution."

msgid ""
"Action Scheduler workload is visible: %1$d pending, %2$d past-due and %3$d "
"failed actions."
msgstr ""
"La charge d’Action Scheduler est visible : %1$d en attente, %2$d en retard "
"et %3$d actions en échec."

#: includes/class-yperf-admin.php
msgid "Activate & Prove Object Cache"
msgstr "Activer et vérifier le cache d’objets"

msgid ""
"Activate W3 Total Cache, prepare the migration, and then deactivate it "
