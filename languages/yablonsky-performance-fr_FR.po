#: includes/class-yperf-admin.php
msgid "AI-assisted Apply was blocked safely."
msgstr "L’application assistée par l’IA a été bloquée en toute sécurité."

#: includes/class-yperf-admin.php
msgid "AI-assisted configuration, human-approved"
msgstr "Configuration assistée par l’IA, approuvée par un humain"

#: includes/class-yperf-admin.php
msgid "AI-assisted performance plan was accepted after Runtime Acceptance."
msgstr ""
"Le plan de performance assisté par l’IA a été accepté après validation de "
