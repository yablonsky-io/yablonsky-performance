msgid ""
"Tracks Runtime Acceptance, benchmark, purge and prewarm activity now; native"
" adapters can add HIT/MISS/BYPASS/STALE, object-cache hit ratio and eviction"
" counters."
msgstr ""
"Följer nu driftmiljökontroll, prestandatest, rensning och förvärmning; "
"inbyggda adaptrar kan lägga till HIT/MISS/BYPASS/STALE, träffandel i "
"objektcache och räknare för utmatning ur cache."

#: includes/class-yperf-admin.php
msgid "Transactional handover is allowed to start."
msgstr "Transaktionssäker överlämning får starta."

#: includes/class-yperf-admin.php
msgid "Transactional handover is blocked."
msgstr "Transaktionssäker överlämning är blockerad."

#: includes/class-yperf-admin.php
msgid "Transactional handover is ready."
msgstr "Transaktionssäker överlämning är klar."

#: includes/class-yperf-admin.php
msgid "Translation integrity rule:"
msgstr "Integritetsregel för översättning:"

#: includes/class-yperf-admin.php
