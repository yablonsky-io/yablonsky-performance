msgid ""
"Turns on and verifies YPerf Page Cache, Browser Cache and safe WordPress "
"frontend optimization. Server configuration and WooCommerce first-hit "
"protection stay unchanged."
msgstr ""
"Aktiverar och verifierar YPerfs sidcache, webbläsarcache och säker "
"optimering av WordPress framsida. Serverkonfiguration och skydd för "
"WooCommerce vid första träff förblir oförändrade."

#: includes/class-yperf-admin.php
msgid "Two-pass confirmation"
msgstr "Bekräftelse i två omgångar"

#: includes/class-yperf-admin.php
msgid "Type"
msgstr "Typ"

