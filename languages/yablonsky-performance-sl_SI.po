#. Extracted from PHP source; i18n unification.
#: includes/class-yperf-admin.php
msgid "Access denied."
msgstr "Dostop zavrnjen."

#: includes/class-yperf-admin.php
msgid "Account verified, but no usable current workspace was returned."
msgstr "Račun je potrjen, vendar ni povrnjen noben uporaben trenutni delovni prostor."

msgid "Action Scheduler is outside the active runtime stack for this site."
msgstr "Action Scheduler ni del aktivnega izvajalnega sistema za to spletno mesto."

msgid ""
"Action Scheduler workload evidence is available after its runtime store "
"initializes."
msgstr ""
"Podatki o obremenitvi Action Schedulerja so na voljo po inicializaciji "
"njegove podatkovne shrambe."

msgid ""
"Action Scheduler workload is visible: %1$d pending, %2$d past-due and %3$d "
"failed actions."
msgstr ""
"Vidno je obremenitev Action Schedulera: %1$d na čakanju, %2$d z preseženim "
"rokom in %3$d neuspešnih dejanju."

#: includes/class-yperf-admin.php
msgid "Activate & Prove Object Cache"
msgstr "Aktiviraj in potrdi objektni predpomnilnik"

msgid ""
"Activate W3 Total Cache, prepare the migration, and then deactivate it "
"yourself from Plugins before YPerf claims any replacement layer."
msgstr ""
"Aktivirajte W3 Total Cache, pripravite migracijo in ga nato sami "
"deaktivirajte na zaslonu Vtičniki, preden YPerf prevzame upravljanje "
"nadomestne plasti."

#: includes/class-yperf-admin.php
msgid "Activate YPerf Object Cache & Prove"
msgstr "Aktiviraj in potrdi YPerf objektni predpomnilnik"

#: includes/class-yperf-migration-journey.php
msgid "Activate a safe YPerf baseline"
msgstr "Aktiviraj varne začetne nastavitve YPerfa"

#: includes/class-yperf-admin.php
msgid "Activate the recommended local profile"
msgstr "Aktiviraj priporočeni lokalni profil"

#: includes/class-yperf-admin.php
msgid "Activate, prove and roll back the YPerf Redis executor"
msgstr ""
"Aktiviraj, potrdi in po potrebi razveljavi izvajalnik Redis predpomnilnika "
