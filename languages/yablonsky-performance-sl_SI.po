#: includes/class-yperf-admin.php
msgid "AI Advisor answered the performance question."
msgstr "AI svetovalec odgovoril je na vprašanje o performansama."

#: includes/class-yperf-admin.php
msgid "AI Advisor created a recommendation. Review the validated plan before Apply."
msgstr ""
"AI svetovalec pripravil je priporočilo. Preglejte preverjeni načrt pred "
"uporabo."

#: includes/class-yperf-admin.php
msgid ""
"AI-assisted Apply is blocked until a clean current-version Runtime "
"Acceptance exists."
msgstr ""
"Uporaba konfiguracije s pomočjo umetne inteligence je blokirana, dokler ne "
"obstaja uspešno preverjanje ustreznosti delovanja za trenutno različico."

#: includes/class-yperf-admin.php
msgid "AI-assisted Apply was blocked safely."
msgstr "Uporaba konfiguracije s pomočjo umetne inteligence je bila varno blokirana."

#: includes/class-yperf-admin.php
msgid "AI-assisted configuration, human-approved"
msgstr "Konfiguracija s pomočjo AI, ki jo odobri človek"

#: includes/class-yperf-admin.php
msgid "AI-assisted performance plan was accepted after Runtime Acceptance."
msgstr ""
"Načrt zmogljivosti z pomočjo umetne inteligence sprejet je po preverjanja "
"ustreznosti delovanja."

#: includes/class-yperf-recommendations.php
msgid "AI-ready evidence"
msgstr "Podatki pripravljeni za AI"

#: includes/class-yperf-admin.php
msgid "AI-ready · local"
msgstr "Pripravljeno za AI · lokalno"

#: includes/class-yperf-admin.php
