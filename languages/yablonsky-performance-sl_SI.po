msgstr "W3 Total Cache ni aktiven pa ni ničesar za predajo."

#: includes/class-yperf-w3tc-migration-executor.php
msgid "W3 Total Cache is not active."
msgstr "W3 Total Cache ni aktiven."

#: includes/class-yperf-admin.php
