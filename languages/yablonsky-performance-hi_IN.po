msgstr "तकनीकी पहचान और कैश स्वामित्व"

#: includes/class-yperf-admin.php
msgid "Technical migration details"
msgstr "तकनीकी माइग्रेशन विवरण"

msgid ""
"Technical view of YPerf-owned and external acceleration layers. Normal cache"
