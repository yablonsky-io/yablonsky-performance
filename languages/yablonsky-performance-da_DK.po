msgstr "Overtag YPerf-profil for Cloudflare"

#: includes/class-yperf-native-page-cache-operations.php
msgid ""
"Adopt a fresh, proven native page-cache executor before preparing host "
"operations."
msgstr ""
"Overtag en nyligt verificeret indbygget sidecachemekanisme, før "
"værtsoperationer forberedes."

#: includes/class-yperf-admin.php
msgid "Adopt aligned profile & enable purge sync"
msgstr "Overtag afstemt profil, og aktivér synkronisering af cacherydning"

#: includes/class-yperf-admin.php
msgid "Adopt performance profile"
msgstr "Overtag ydelsesprofil"

#: includes/class-yperf-admin.php
msgid "Adopt proven Nginx page cache"
msgstr "Overtag verificeret Nginx-sidecache"

#: includes/class-yperf-admin.php
