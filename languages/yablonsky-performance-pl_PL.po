msgstr "Widoczne nawet wtedy, gdy niedostępne; YPerf nigdy nie ukrywa wyboru."

#: includes/class-yperf-admin.php
msgid "Visible without a deeper scan."
msgstr "Widoczne bez głębszego skanowania."

#: includes/class-yperf-admin.php
msgid "Visible work."
msgstr "Widoczne działanie."

#: includes/class-yperf-w3tc-migration-executor.php
msgid ""
"W3 Total Cache Object Cache is active and YPerf Object Cache is not yet "
