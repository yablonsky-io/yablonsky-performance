msgstr "Gníomhachtaigh, fíoraigh agus cuir feidhmitheoir Redis YPerf ar ais"

msgid "Activating the YPerf Page Cache replacement."
msgstr "Ionadú Taisce Leathanaigh YPerf á ghníomhachtú."

#: includes/class-yperf-page-cache-campaign.php
