msgstr "YouTube оптимізовано"

msgid "Your confirmation is required in WordPress Plugins"
msgstr "Потрібне ваше підтвердження в розділі «Плагіни» WordPress"

#: includes/class-yperf-admin.php
msgid "Zone"
msgstr "Зона"

#: includes/class-yperf-admin.php
