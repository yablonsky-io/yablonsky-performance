msgstr ""
"La aplicación asistida por IA queda bloqueada hasta que haya una validación "
"correcta de la versión actual en ejecución."

#: includes/class-yperf-admin.php
msgid "AI-assisted Apply was blocked safely."
msgstr "La aplicación asistida por IA se bloqueó de forma segura."

#: includes/class-yperf-admin.php
msgid "AI-assisted configuration, human-approved"
msgstr "Configuración asistida por IA, aprobada por una persona"

#: includes/class-yperf-admin.php
msgid "AI-assisted performance plan was accepted after Runtime Acceptance."
msgstr ""
"El plan de rendimiento asistido por IA se aceptó tras la validación en "
"ejecución."

