#: includes/class-yperf-admin.php
msgid "Adopt Current FPM Budget"
msgstr "Adotta il limite FPM corrente"

#: includes/class-yperf-admin.php
msgid "Adopt YPerf Cloudflare profile"
msgstr "Adotta il profilo Cloudflare di YPerf"

#: includes/class-yperf-native-page-cache-operations.php
msgid "Adopt a fresh, proven native page-cache executor before preparing host operations."
msgstr ""
"Adotta un esecutore di cache delle pagine nativa aggiornato e verificato prima di preparare le "
"operazioni sull'host."

#: includes/class-yperf-admin.php
msgid "Adopt aligned profile & enable purge sync"
msgstr "Adotta il profilo allineato e abilita la sincronizzazione dello svuotamento"

#: includes/class-yperf-admin.php
msgid "Adopt performance profile"
msgstr "Adotta il profilo prestazionale"

#: includes/class-yperf-admin.php
